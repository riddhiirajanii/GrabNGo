# Required: generate a unique random secret of at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

PORT=3000
NODE_ENV=development

# Local PostgreSQL 18 example (this project setup uses port 5433).
# On Render, use the database INTERNAL connection URL.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5433/grabngo?schema=public"

# Required to encrypt retrievable pickup PINs. Generate with:
# npm run secrets:pickup-pin
PICKUP_PIN_ENCRYPTION_KEY=

# Student sign-in uses one-time codes delivered to @iitp.ac.in email.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Grab n Go <no-reply@iitp.ac.in>

# Payments and Student Pass remain disabled until a payment gateway is integrated.
